      "integration": "B2.2A.2: mandatory append after shared owner event INSERT for CONFIRMED/CANCELLED/COMPLETED"
    },
    {
      "path": "src/main/java/kz/rm/sales/SalesPickupHandoverService.java",
      "table": "sales_order_status_event",
