{
  "schema": "RM-B2.1R/producer-inventory/v1",
  "scope": "Nine admitted literal INSERT sites in eight owner Java classes; conservative alternate producer detection across src/main Java, SQL and XML; test fixtures excluded",
  "producers": [
    {
      "path": "src/main/java/kz/rm/autoorder/AutoOrderService.java",
      "table": "sales_order_status_event",
